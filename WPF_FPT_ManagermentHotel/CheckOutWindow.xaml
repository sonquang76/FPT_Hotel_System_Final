<Window x:Class="WPF_FPT_ManagementHotel.CheckOutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="Check Out" Height="560" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1E2030">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Header -->
            <RowDefinition Height="*"/>
            <!-- 2. Chi tiết Check Out chia 2 cột -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Nút hành động -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER SECTION -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thanh đứng màu Gold sang trọng -->
                <Border Grid.Column="0" Width="4" Height="36" Background="#F1C40F" CornerRadius="2" Margin="0,2,12,0" VerticalAlignment="Top"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <!-- Tiêu đề với dải màu Gradient ánh kim -->
                    <TextBlock Text="CHECK OUT" FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#E2E8F0" Offset="0.5"/>
                                <GradientStop Color="#94A3B8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Please review the guest stay details and billing overview below." FontSize="11" Foreground="#A0A5C1" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <Separator Background="#444A73" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- 2. DETAILS SECTION (Chia 2 Cột Song Song) -->
        <Grid Grid.Row="1" Margin="0,5,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <!-- Cột trái: Stay Details -->
                <ColumnDefinition Width="1*"/>
                <!-- Cột phải: Billing -->
            </Grid.ColumnDefinitions>

            <!-- 2.1 STAY DETAILS (Cột trái) -->
            <Border Grid.Column="0" Background="#25283D" CornerRadius="10" Padding="15" Margin="0,0,10,0" BorderBrush="#444A73" BorderThickness="1" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="STAY DETAILS" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                    <TextBlock Text="Customer" Foreground="#A0A5C1" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCustomer" IsReadOnly="True" Height="32" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Room" Foreground="#A0A5C1" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtRoom" IsReadOnly="True" Height="32" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Check In" Foreground="#A0A5C1" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCheckIn" IsReadOnly="True" Height="32" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Expected Check Out" Foreground="#A0A5C1" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtExpectedCheckout" IsReadOnly="True" Height="32" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>

            <!-- 2.2 BILLING OVERVIEW (Cột phải) -->
            <Border Grid.Column="1" Background="#25283D" CornerRadius="10" Padding="15" BorderBrush="#444A73" BorderThickness="1" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="BILLING OVERVIEW" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                    <TextBlock Text="Room Price" Foreground="#A0A5C1" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtRoomPrice" IsReadOnly="True" Height="32" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Total Service Used" Foreground="#A0A5C1" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtServicePrice" IsReadOnly="True" Height="32" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,0,0,10"/>

                    <Separator Background="#444A73" Margin="0,5,0,10"/>

                    <!-- Hộp lưu ý thiết kế hiện đại -->
                    <Border Background="#102ECC71" BorderBrush="#202ECC71" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="READY TO DEPART?" FontWeight="Bold" Foreground="#2ECC71" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Double check check-in details and services. Clicking 'Check Out' will finalize the room transaction." FontSize="10" Foreground="#A0A5C1" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ACTIONS BUTTONS SECTION -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">

            <!-- Nút Checkout (btnCheckout - Click="btnCheckout_Click") -->
            <Button x:Name="btnCheckout" Click="btnCheckout_Click" Content="Check Out" Width="130" Height="38" Margin="0,0,12,0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2ECC71"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#27AE60"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Nút Close (Click="Close_Click") -->
            <Button Click="Close_Click" Content="Close" Width="100" Height="38" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2F334D"/>
                        <Setter Property="Foreground" Value="#A0A5C1"/>
                        <Setter Property="BorderBrush" Value="#444A73"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444A73"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Grid>
</Window>