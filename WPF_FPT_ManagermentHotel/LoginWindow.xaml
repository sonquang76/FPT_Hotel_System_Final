<Window x:Class="WPF_FPT_ManagementHotel.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="LoginWindow" Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">

    <Window.Resources>
        <!-- Style cho Tiêu đề Label -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <!-- Style TextBox -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F334D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2ECC71"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8"
                                x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C638A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                                <Setter TargetName="border" Property="Background" Value="#353A56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style PasswordBox -->
        <Style TargetType="PasswordBox" x:Key="ModernPasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F334D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2ECC71"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8"
                                x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C638A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                                <Setter TargetName="border" Property="Background" Value="#353A56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Primary Button (Nút Đăng Nhập) - Nổi bật -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                x:Name="border">
                            <!-- Hiệu ứng toả sáng xanh lá -->
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="12" Opacity="0.4" ShadowDepth="0" Direction="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E8449"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Secondary Button (Nút Đăng Ký) - Ghost Style -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                                <Setter Property="Foreground" Value="#2ECC71"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F334D"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Chia tỷ lệ: Bên trái chiếm 1 phần, bên phải chứa Form lớn hơn xíu (1.2 phần) -->
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>
        <!-- Cột Trái: Branding / Banner Mời gọi -->
        <Border Grid.Column="0">
            <!-- Hiệu ứng Gradient mượt mà cho khối trái -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A1C29" Offset="0" />
                    <GradientStop Color="#25283D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <!-- Logo giả lập tinh tế -->
                <Border Width="80" Height="80" Background="#2ECC71" CornerRadius="20" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#2ECC71" BlurRadius="25" Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>
                    <TextBlock Text="H" FontSize="42" FontWeight="Black" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="FPT HOTEL" FontSize="32" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="MANAGEMENT SYSTEM" FontSize="15" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                <TextBlock Text="Welcome to the premium hotel operations management platform." 
                           Foreground="#8E93B0" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" MaxWidth="250"/>
            </StackPanel>
        </Border>
        <!-- Cột Phải: Form Đăng nhập -->
        <Grid Grid.Column="1" Background="#1E2030">
            <StackPanel VerticalAlignment="Center" Margin="60,0,70,0">

                <!-- Tiêu đề Form -->
                <TextBlock Text="Đăng nhập hệ thống" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <TextBlock Text="Welcome back! Please enter your details." FontSize="14" Foreground="#A0A5C1" Margin="0,0,0,45"/>
                <!-- Ô nhập Email -->
                <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource LabelStyle}"/>
                <!-- Giữ nguyên x:Name="txtEmail" -->
                <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}" Margin="0,0,0,25"/>
                <!-- Ô nhập Password -->
                <TextBlock Text="PASSWORD" Style="{StaticResource LabelStyle}"/>
                <!-- Giữ nguyên x:Name="txtPassword" -->
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,45"/>
                <!-- Hai nút Login và Register -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <!-- Khoảng cách giữa 2 nút -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Giữ nguyên x:Name="btnLogin" và Sự kiện Click -->
                    <Button x:Name="btnLogin" Content="SIGN IN" 
                            Style="{StaticResource PrimaryButton}" 
                            Click="btnLogin_Click" 
                            Grid.Column="0"/>

                    <!-- Giữ nguyên x:Name="btnSignUp" và Sự kiện Click -->
                    <Button x:Name="btnSignUp" Content="SIGN UP" 
                            Style="{StaticResource GhostButton}" 
                            Click="btnSignUp_Click" 
                            Grid.Column="2"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</Window>