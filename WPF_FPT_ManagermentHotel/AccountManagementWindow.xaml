<Window x:Class="WPF_FPT_ManagementHotel.AccountManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="System Account Management (Manager Mode)" Height="830" Width="1240"
        Background="#1E2030" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#25283D" CornerRadius="10" Padding="20" Margin="0,0,20,0" Height="750" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="lblFormHeader" Text="ACCOUNT INFORMATION" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Password" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="5,0,0,0" Margin="0,0,0,15"/>

                    <TextBlock Text="Full Name" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFullName" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="5,0,0,0" Margin="0,0,0,15"/>

                    <TextBlock Text="Gender" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboGender" Height="30" Background="#2F334D" Foreground="#000000" BorderBrush="#444A73" Margin="0,0,0,15">
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <TextBlock Text="Date of Birth" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpDob" Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Email" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="5,0,0,0" Margin="0,0,0,15"/>

                    <TextBlock Text="Phone" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPhone" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="5,0,0,0" Margin="0,0,0,15"/>

                    <TextBlock Text="Identity Card" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtIdentityCard" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="5,0,0,0" Margin="0,0,0,15"/>

                    <TextBlock Text="Account Status" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboAccountStatus" Height="30" Background="#2F334D" Foreground="#000000" BorderBrush="#444A73" Margin="0,0,0,25">
                        <ComboBoxItem Content="ACTIVE" IsSelected="True"/>
                        <ComboBoxItem Content="UNDEACTIVE"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnSaveAccount" Grid.Column="0" Content="SAVE ACCOUNT" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnSaveAccount_Click"/>
                        <Button x:Name="btnClear" Grid.Column="2" Content="CLEAR FORM" Height="40" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnClear_Click"/>
                    </Grid>
                    <Button x:Name="btnBack" Content="&#x2190; BACK TO MENU" Height="40" Background="#7F8C8D" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" Click="BtnBack_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#25283D" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtSearch" Grid.Column="0" Height="35" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="10,0,0,0"/>
                    <Button x:Name="btnSearch" Grid.Column="1" Content="SEARCH" Width="100" Height="35" Background="#F1C40F" Foreground="#1E2030" FontWeight="Bold" Margin="10,0,0,0" Click="BtnSearch_Click"/>
                </Grid>
            </Border>
            <!-- Khung danh sách Lễ tân thay thế cho TabControl -->
            <Border Grid.Row="1" Background="#25283D" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề danh sách -->
                    <TextBlock Grid.Row="0" Text="RECEPTIONISTS LIST" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,15"/>

                    <!-- Bảng dữ liệu -->
                    <DataGrid Grid.Row="1" x:Name="dgReceptionists" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                              SelectionChanged="dgReceptionists_SelectionChanged"
                              Background="Transparent" RowBackground="#2F334D" AlternatingRowBackground="#25283D" 
                              Foreground="#FFFFFF" BorderBrush="#444A73" HorizontalGridLinesBrush="#1E2030" VerticalGridLinesBrush="#1E2030">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#444A73"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,5,10,5"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="140"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="70"/>
                            <DataGridTextColumn Header="Date of Birth" Binding="{Binding Dob, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="140"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                            <DataGridTextColumn Header="Identity Card" Binding="{Binding IdentityCard}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding AccountStatus}" Width="90"/>

                            <DataGridTemplateColumn Header="Action" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="C.Status" Background="#E74C3C" Foreground="White" FontSize="11" FontWeight="Bold" Padding="5,2" Height="24" Click="BtnDeleteStatus_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>