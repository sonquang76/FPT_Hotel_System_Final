<Window x:Class="WPF_FPT_ManagementHotel.ConfirmReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="Confirm Reservation" Height="520" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#1E2030">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Header -->
            <RowDefinition Height="*"/>
            <!-- 2. Chi tiết Đơn đặt chia 2 cột -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Nút hành động -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER SECTION (Đã sửa đúng thẻ ColumnDefinition) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thanh đứng màu Gold tạo nét sang trọng -->
                <Border Grid.Column="0" Width="4" Height="36" Background="#F1C40F" CornerRadius="2" Margin="0,2,12,0" VerticalAlignment="Top"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <!-- Tiêu đề với dải màu Gradient ánh kim -->
                    <TextBlock Text="CONFIRM RESERVATION" FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#E2E8F0" Offset="0.5"/>
                                <GradientStop Color="#94A3B8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Please review the guest account and booking summary details below." FontSize="11" Foreground="#A0A5C1" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <Separator Background="#444A73" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- 2. DETAILS SECTION (Chia 2 Cột Song Song) -->
        <Grid Grid.Row="1" Margin="0,10,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <!-- Cột thông tin khách hàng -->
                <ColumnDefinition Width="1.2*"/>
                <!-- Cột thông tin phòng -->
            </Grid.ColumnDefinitions>

            <!-- 2.1 GUEST DETAILS (Cột trái) -->
            <Border Grid.Column="0" Background="#25283D" CornerRadius="10" Padding="18" Margin="0,0,15,0" BorderBrush="#444A73" BorderThickness="1" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="GUEST DETAILS" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,18"/>

                    <TextBlock Text="Customer ID" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="10,0,0,0" Margin="0,0,0,15">
                        <TextBlock Text="{Binding CreatedBy}" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                    </Border>

                    <TextBlock Text="Full Name" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="10,0,0,0" Margin="0,0,0,15">
                        <TextBlock Text="{Binding CreatedByNavigation.FullName}" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                    </Border>

                    <TextBlock Text="Phone Number" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                    <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="10,0,0,0" Margin="0,0,0,5">
                        <TextBlock Text="{Binding CreatedByNavigation.Phone}" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2.2 BOOKING SUMMARY (Cột phải) -->
            <Border Grid.Column="1" Background="#25283D" CornerRadius="10" Padding="18" BorderBrush="#444A73" BorderThickness="1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Tiêu đề thẻ -->
                        <RowDefinition Height="*"/>
                        <!-- Danh sách thông tin -->
                        <RowDefinition Height="Auto"/>
                        <!-- Ngăn cách -->
                        <RowDefinition Height="Auto"/>
                        <!-- Giá phòng -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="BOOKING SUMMARY" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,18"/>

                    <!-- Danh sách thông tin -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <TextBlock Text="Booking ID" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                        <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="10,0,0,0" Margin="0,0,0,12">
                            <TextBlock Text="{Binding BookingId, StringFormat='#BK-{0}'}" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        </Border>

                        <TextBlock Text="Room Number" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                        <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="10,0,0,0" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Room.RoomId, StringFormat='Room {0}'}" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        </Border>

                        <!-- Hai ô thời gian được đặt song song -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Expected In" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                                <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="8,0,0,0">
                                    <TextBlock Text="{Binding ExpectedCheckIn, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Expected Out" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                                <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="8,0,0,0">
                                    <TextBlock Text="{Binding ExpectedCheckOut, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Status" Foreground="#A0A5C1" Margin="0,0,0,5"/>
                        <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="5" Height="32" Padding="10,0,0,0" Margin="0,0,0,5">
                            <TextBlock Text="{Binding BookingStatus}" Foreground="#2ECC71" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <!-- Phần giá tiền nằm cố định ở đáy thẻ -->
                    <Separator Grid.Row="2" Background="#444A73" Margin="0,10,0,12"/>

                    <Grid Grid.Row="3">
                        <TextBlock Text="Room Price/Night" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Room.RoomPrice, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. ACTIONS BUTTONS SECTION -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

            <!-- Nút huỷ lệnh (btnCancel) -->
            <Button x:Name="btnCancel" Click="BtnCancel_Click" Content="Cancel" Width="100" Height="35" Margin="0,0,12,0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2F334D"/>
                        <Setter Property="Foreground" Value="#A0A5C1"/>
                        <Setter Property="BorderBrush" Value="#444A73"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444A73"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Nút xác nhận xử lý Check-In (btnConfirm) -->
            <Button x:Name="btnConfirm" Click="BtnConfirm_Click" Content="Process Check-In" Width="140" Height="35" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2ECC71"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#27AE60"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Grid>
</Window>