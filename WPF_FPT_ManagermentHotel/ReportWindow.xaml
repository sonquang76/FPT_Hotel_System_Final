<Window x:Class="WPF_FPT_ManagementHotel.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="Hotel Reports" Height="600" Width="980"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#1E2030">

    <Window.Resources>
        <!-- Style Button Ghost cho nút Back -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F334D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Dashboard Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--================ 1. HEADER SECTION ================-->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Nút Back -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Thanh màu Gold -->
                    <ColumnDefinition Width="*"/>
                    <!-- Tiêu đề -->
                </Grid.ColumnDefinitions>

                <!-- Nút BACK -->
                <Button x:Name="btnBack" Grid.Column="0" Content="&#x2190; BACK" 
                        Style="{StaticResource GhostButton}" Width="85" Height="36" 
                        Margin="0,0,20,0" VerticalAlignment="Top" Click="btnBack_Click"/>

                <!-- Thanh đứng màu Gold sang trọng -->
                <Border Grid.Column="1" Width="4" Height="36" Background="#F1C40F" CornerRadius="2" Margin="0,0,12,0" VerticalAlignment="Top"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="HOTEL FINANCIAL &amp; METRICS REPORT" FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#E2E8F0" Offset="0.5"/>
                                <GradientStop Color="#94A3B8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Analyze hotel booking, service revenues, and occupancy metrics." FontSize="11" Foreground="#A0A5C1" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <Separator Background="#444A73" Margin="0,12,0,0"/>
        </StackPanel>

        <!--================ 2. MAIN DASHBOARD AREA (2 Cột) ================-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: KPI Summary Sidebar -->
                <ColumnDefinition Width="280"/>
                <!-- Khoảng cách giữa 2 cột -->
                <ColumnDefinition Width="15"/>
                <!-- Cột phải: Filters & Data Grid -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT TRÁI (KPI SUMMARY SIDEBAR) ================= -->
            <StackPanel Grid.Column="0">

                <!-- KPI Card: Tổng Doanh Thu (Total Revenue) -->
                <Border Background="#1A1C2C" BorderBrush="#444A73" BorderThickness="1" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock x:Name="lblKpiTitle" Text="TOTAL REVENUE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        <!-- txtRevenue hiển thị nổi bật với cỡ chữ 24 -->
                        <TextBlock x:Name="txtRevenue" Text="0 VND" FontSize="24" FontWeight="Black" Foreground="#2ECC71" Margin="0,12,0,5" TextWrapping="Wrap"/>
                        <!-- TextBlock mới để hiển thị chữ nhỏ gọn hơn không bị tràn dòng -->
                        <TextBlock x:Name="txtOccupancyStats" Text="" FontSize="13" Foreground="#FFFFFF" Margin="0,10,0,5" Visibility="Collapsed" LineHeight="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Based on selected report filters" FontSize="10" Foreground="#A0A5C1"/>
                    </StackPanel>
                </Border>

                <!-- Information Card: Hướng dẫn / Mô tả nhanh -->
                <Border Background="#25283D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="REPORT GUIDELINES" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <TextBlock Text="• Revenue Report: Financial summary of room sales and booking activities." FontSize="11" Foreground="#A0A5C1" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="15"/>
                        <TextBlock Text="• Occupancy Report: Tracks room reservation status and capacity limits." FontSize="11" Foreground="#A0A5C1" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="15"/>
                        <TextBlock Text="• Service Usage: Statistics of food, amenities, and room services ordered." FontSize="11" Foreground="#A0A5C1" TextWrapping="Wrap" LineHeight="15"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= CỘT PHẢI (FILTERS & DATA GRIDS) ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Bộ lọc phía trên -->
                    <RowDefinition Height="Auto"/>
                    <!-- Bảng dữ liệu phía dưới -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bộ lọc tinh gọn (Filters Card) -->
                <Border Grid.Row="0" Background="#25283D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,15">
                    <WrapPanel VerticalAlignment="Center">

                        <!-- Chọn loại báo cáo -->
                        <TextBlock Text="Report" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="12"/>
                        <ComboBox x:Name="cboReport" Width="170" Height="32" Background="#2F334D" Foreground="#000000" BorderBrush="#444A73" Margin="0,0,15,0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Revenue Report" IsSelected="True"/>
                            <ComboBoxItem Content="Occupancy Report"/>
                            <ComboBoxItem Content="Service Usage Report"/>
                        </ComboBox>

                        <!-- Chọn Tháng -->
                        <TextBlock Text="Month" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="12"/>
                        <ComboBox x:Name="cboMonth" Width="75" Height="32" Background="#2F334D" Foreground="#000000" BorderBrush="#444A73" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

                        <!-- Chọn Năm -->
                        <TextBlock Text="Year" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="12"/>
                        <ComboBox x:Name="cboYear" Width="90" Height="32" Background="#2F334D" Foreground="#000000" BorderBrush="#444A73" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

                        <!-- Nút kích hoạt Generate Báo cáo -->
                        <Button x:Name="btnGenerate" Click="btnGenerate_Click" Content="Generate" Width="110" Height="32" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2ECC71"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#27AE60"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </WrapPanel>
                </Border>

                <!-- Vùng hiển thị Data Grids (Data Grid Border Card) -->
                <Border Grid.Row="1" Background="#25283D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="10" Padding="15">
                    <Grid>
                        <!-- Revenue Report -->
                        <DataGrid x:Name="dgRevenue"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent" 
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" 
                                  RowBackground="#2F334D" 
                                  AlternatingRowBackground="#25283D" 
                                  Foreground="#FFFFFF" 
                                  HorizontalGridLinesBrush="#1E2030" 
                                  VerticalGridLinesBrush="#1E2030">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#444A73"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceId}" Width="80"/>
                                <DataGridTextColumn Header="Booking ID" Binding="{Binding BookingId}" Width="80"/>
                                <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" Width="70" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="140"/>
                                <DataGridTextColumn Header="Room Charge" Binding="{Binding RoomCharge}" Width="100"/>
                                <DataGridTextColumn Header="Service Charge" Binding="{Binding ServiceCharge}" Width="100"/>
                                <DataGridTextColumn Header="Discount" Binding="{Binding Discount}" Width="90"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount}" Width="110" Foreground="#2ECC71" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Payment Date" Binding="{Binding PaymentDate}" Width="140"/>
                                <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Reservation Report -->
                        <DataGrid x:Name="dgReservation"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="Transparent" 
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" 
                                  RowBackground="#2F334D" 
                                  AlternatingRowBackground="#25283D" 
                                  Foreground="#FFFFFF" 
                                  HorizontalGridLinesBrush="#1E2030" 
                                  VerticalGridLinesBrush="#1E2030">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#444A73"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Room ID" Binding="{Binding RoomId}" Width="80"/>
                                <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Floor" Binding="{Binding Floor}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Room Type" Binding="{Binding RoomType.TypeName}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Service Usage Report -->
                        <DataGrid x:Name="dgService"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent" 
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal" 
                                  RowBackground="#2F334D" 
                                  AlternatingRowBackground="#25283D" 
                                  Foreground="#FFFFFF" 
                                  HorizontalGridLinesBrush="#1E2030" 
                                  VerticalGridLinesBrush="#1E2030">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#444A73"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Booking ID" Binding="{Binding BookingId}"/>
                                <DataGridTextColumn Header="Service ID" Binding="{Binding ServiceId}"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding OrderStatus}"/>
                                <DataGridTextColumn Header="Order Time" Binding="{Binding OrderTime}"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Foreground="#F39C12" FontWeight="SemiBold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>