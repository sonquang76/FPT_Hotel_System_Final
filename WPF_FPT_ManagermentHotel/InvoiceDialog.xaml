<Window x:Class="WPF_FPT_ManagementHotel.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="Invoice" Height="850" Width="950"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#1E2030">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Body (Kéo giãn được) -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!--================ HEADER (Row 0) ================-->
        <Border Grid.Row="0" Background="#25283D" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#444A73" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thanh đứng màu Gold sang trọng -->
                <Border Grid.Column="0" Width="4" Height="46" Background="#F1C40F" CornerRadius="2" Margin="0,2,15,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="FPT HOTEL" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="HOTEL INVOICE • Thank you for choosing our hotel" FontSize="12" Foreground="#A0A5C1" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--================ BODY (Row 1) ================-->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--================ Invoice Information ================-->
                <GroupBox Header="Invoice Information"
                          Foreground="#38BDF8"
                          BorderBrush="#444A73"
                          Background="#25283D"
                          FontWeight="Bold"
                          Margin="0,0,0,15"
                          Padding="10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Invoice ID" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtInvoiceID" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Column="2" Text="Booking ID" Foreground="#A0A5C1" VerticalAlignment="Top" Margin="35,10,251,0" Grid.ColumnSpan="2"/>
                        <TextBox x:Name="txtBookingID" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Text="Booking Status" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtStatus" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#2ECC71" FontWeight="Bold" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Created By" Foreground="#A0A5C1" VerticalAlignment="Top" Margin="35,10,251,0" Grid.ColumnSpan="2"/>
                        <TextBox x:Name="txtCreatedBy" Grid.Row="1" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>
                    </Grid>
                </GroupBox>

                <!--================ Customer Information ================-->
                <GroupBox Header="Customer Information"
                          Foreground="#38BDF8"
                          BorderBrush="#444A73"
                          Background="#25283D"
                          FontWeight="Bold"
                          Margin="0,0,0,15"
                          Padding="10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Customer Name" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtCustomerName" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Column="2" Text="Phone" Foreground="#A0A5C1" VerticalAlignment="Top" Margin="46,7,240,0" Grid.ColumnSpan="2"/>
                        <TextBox x:Name="txtPhone" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Text="Email" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtEmail" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>
                    </Grid>
                </GroupBox>

                <!--================ Room Information ================-->
                <GroupBox Header="Room Information"
                          Foreground="#38BDF8"
                          BorderBrush="#444A73"
                          Background="#25283D"
                          FontWeight="Bold"
                          Margin="0,0,0,15"
                          Padding="10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Room Number" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtRoomNumber" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Column="2" Text="Room Type" Foreground="#A0A5C1" VerticalAlignment="Top" Margin="44,10,22,0"/>
                        <TextBox x:Name="txtRoomType" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Text="Price / Night" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPricePerNight" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Text="Description" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtRoomDescription" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>
                    </Grid>
                </GroupBox>

                <!--================ Booking Information ================-->
                <GroupBox Header="Booking Information"
                          Foreground="#38BDF8"
                          BorderBrush="#444A73"
                          Background="#25283D"
                          FontWeight="Bold"
                          Margin="0,0,0,15"
                          Padding="10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Expected Check In" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtExpectedCheckIn" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Column="2" Text="Expected Check Out" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtExpectedCheckOut" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Text="Actual Check In" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtActualCheckIn" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Actual Check Out" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtActualCheckOut" Grid.Row="1" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Text="Number Of Nights" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtNight" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Receptionist" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtReceptionist" Grid.Row="2" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>
                    </Grid>
                </GroupBox>

                <!--================ Services Used ================-->
                <GroupBox Header="Services Used"
                          Foreground="#38BDF8"
                          BorderBrush="#444A73"
                          Background="#25283D"
                          FontWeight="Bold"
                          Margin="0,0,0,15"
                          Padding="10">
                    <DataGrid x:Name="dgServices"
                              Height="180"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="#25283D" 
                              RowBackground="#2F334D" 
                              AlternatingRowBackground="#25283D" 
                              Foreground="#FFFFFF" 
                              BorderBrush="#444A73" 
                              HorizontalGridLinesBrush="#1E2030" 
                              VerticalGridLinesBrush="#1E2030">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#444A73"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No." Width="50" Binding="{Binding STT}"/>
                            <DataGridTextColumn Header="Service Name" Width="*" Binding="{Binding Service.ServiceName}"/>
                            <DataGridTextColumn Header="Unit Price" Width="130" Binding="{Binding Service.Price,StringFormat=N0}"/>
                            <DataGridTextColumn Header="Quantity" Width="90" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Amount" Width="140" Binding="{Binding TotalPrice,StringFormat=N0}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!--================ Invoice Summary ================-->
                <GroupBox Header="Invoice Summary"
                          Foreground="#38BDF8"
                          BorderBrush="#444A73"
                          Background="#25283D"
                          FontWeight="Bold"
                          Margin="0,0,0,10"
                          Padding="10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Room Charge" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtRoomCharge" Grid.Column="1" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Column="2" Text="Service Charge" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtServiceCharge" Grid.Column="3" IsReadOnly="True" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Text="Sub Total" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSubTotal" Grid.Row="1" Grid.Column="1" IsReadOnly="True" FontWeight="Bold" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Discount" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtDiscount" Grid.Row="1" Grid.Column="3" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Text="VAT (%)" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtVAT" Grid.Row="2" Grid.Column="1" Text="10" Height="30" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Payment Method" Foreground="#A0A5C1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox x:Name="cbPaymentMethod" Grid.Row="2" Grid.Column="3" Margin="0,5" Height="30" Background="#2F334D" Foreground="#000000" BorderBrush="#444A73">
                            <ComboBoxItem Content="Cash"/>
                            <ComboBoxItem Content="Credit Card"/>
                            <ComboBoxItem Content="Bank Transfer"/>
                            <ComboBoxItem Content="Momo"/>
                            <ComboBoxItem Content="VNPay"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Text="Payment Date" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dpPaymentDate" Grid.Row="3" Grid.Column="1" Margin="0,5" Height="30" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Total Amount" FontSize="14" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtTotalAmount" Grid.Row="3" Grid.Column="3" FontSize="14" FontWeight="Bold" Foreground="#E74C3C" IsReadOnly="True" Height="30" Background="#2F334D" BorderBrush="#444A73" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,5"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!--================ FOOTER BUTTONS (Row 2) ================-->
        <Border Grid.Row="2" Background="#25283D" BorderBrush="#444A73" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Grand Total: " FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="lblGrandTotal" FontSize="22" FontWeight="Bold" Foreground="#E74C3C" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Nút In (btnPrint - Click="btnPrint_Click") -->
                    <Button x:Name="btnPrint" Click="btnPrint_Click" Content="🖨 Print" Width="110" Height="35" Margin="5,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Nút Lưu (btnSave - Click="btnSave_Click") -->
                    <Button x:Name="btnSave" Click="btnSave_Click" Content="💾 Save" Width="110" Height="35" Margin="5,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2ECC71"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#27AE60"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Nút Đóng (btnClose - Click="btnClose_Click") -->
                    <Button x:Name="btnClose" Click="btnClose_Click" Content="❌ Close" Width="110" Height="35" Margin="5,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2F334D"/>
                                <Setter Property="Foreground" Value="#A0A5C1"/>
                                <Setter Property="BorderBrush" Value="#444A73"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#444A73"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>