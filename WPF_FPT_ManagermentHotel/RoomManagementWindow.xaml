<Window x:Class="WPF_FPT_ManagementHotel.RoomManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Management"
       Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Style TextBox Tĩnh -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1E2030"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Button Primary Tĩnh -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Button Ghost Tĩnh -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGrid Styles Tĩnh (Dark Theme) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#25283D"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#25283D"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2D45"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#353A56"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="45"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E2030"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style cho Nút Action (Sửa/Xóa) trong Bảng -->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Control Panel -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>
        <!-- 1. HEADER TITLE (Đã chỉnh sửa để thêm nút BACK) -->
        <Grid Grid.Row="0" Margin="30,25,30,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nút BACK -->
            <Button x:Name="btnBack" Grid.Column="0" Content="&#x2190; BACK" Style="{StaticResource GhostButton}" Width="100" Height="45" Margin="0,0,20,0" Click="btnBack_Click"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="45" Height="45" Background="#2ECC71" CornerRadius="8" Margin="0,0,15,0">
                    <TextBlock Text="🏨" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ROOM MANAGEMENT" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <!-- 2. CONTROL PANEL -->
        <Border Grid.Row="1" Background="#25283D" CornerRadius="12" Margin="30,10,30,20" Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="20" Opacity="0.4" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <!-- Spacer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Vùng Tìm kiếm & Lọc -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Vùng Nút Add -->
                </Grid.ColumnDefinitions>
                <!-- Hàng 1: Thanh Tìm Kiếm -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="txtSearch" Style="{StaticResource ModernTextBox}" Width="580" Margin="0,0,10,0" ToolTip="Search Room Number"/>
                    <Button x:Name="btnSearch" Content="SEARCH" Style="{StaticResource ModernButton}" Width="120" Click="btnSearch_Click"/>
                </StackPanel>

                <!-- Nút Add Room (Góc phải) -->
                <Button x:Name="btnAdd" Grid.Row="0" Grid.Column="1" Content="+ ADD ROOM" 
                        Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Height="48" Width="150" Cursor="Hand"
                        Click="btnAdd_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Hàng 2: Bộ Lọc (Floor, Status) -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FLOOR:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#1E2030" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="48" Width="140" Margin="0,0,20,0">
                        <ComboBox x:Name="cboFloor" Foreground="Black" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                    </Border>
                    <TextBlock Text="STATUS:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#1E2030" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="48" Width="180" Margin="0,0,20,0">
                        <ComboBox x:Name="cboStatus" Foreground="Black" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0">
                            <ComboBoxItem Content="Available"/>
                            
                            <ComboBoxItem Content="Maintenance"/>
                        </ComboBox>
                    </Border>
                    <!-- Nút Lọc và Show All -->
                    <Button x:Name="btnFilter" Content="FILTER" Style="{StaticResource ModernButton}" Background="#3498DB" Width="110" Margin="0,0,15,0" Click="btnFilter_Click"/>
                    <!-- Giữ nguyên Click="Button_Click" như code cũ của bạn -->
                    <Button Content="SHOW ALL" Style="{StaticResource GhostButton}" Width="110" Click="Button_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 3. DATA GRID (BẢNG DỮ LIỆU) -->
        <Border Grid.Row="2" Background="#25283D" CornerRadius="12" Margin="30,0,30,30" Padding="15">
            <DataGrid x:Name="dgRoom"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <!-- Cột Dữ Liệu -->
                    <DataGridTextColumn Header="ID" Width="60" Binding="{Binding RoomId}"/>
                    <DataGridTextColumn Header="Room No" Width="120" Binding="{Binding RoomNumber}"/>
                    <DataGridTextColumn Header="Status" Width="120" Binding="{Binding Status}"/>
                    <DataGridTextColumn Header="Floor" Width="80" Binding="{Binding Floor}"/>
                    <DataGridTextColumn Header="Type" Width="220" Binding="{Binding RoomType.TypeName}"/>
                    <DataGridTextColumn Header="Price" Width="140" Binding="{Binding RoomType.BasePrice, StringFormat={}{0:N0} VND}"/>
                    <DataGridTextColumn Header="Cap" Width="80" Binding="{Binding RoomType.Capacity}"/>
                    <!-- Cột Action -->
                    <DataGridTemplateColumn Header="Action" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Nút Sửa -->
                                    <Button Content="✏️" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#3498DB" 
                                            Tag="{Binding}" 
                                            Click="btnUpdate_Click"/>
                                    <!-- Nút Xóa -->
                                    <Button Content="🗑️" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            Background="#E74C3C" 
                                            Tag="{Binding}" 
                                            Click="btnDelete_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>