<Window x:Class="WPF_FPT_ManagementHotel.ExtendReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="ExtendReservationDialog" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Style Giá trị (Value) -->
        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Style Button Primary (Xác nhận) tĩnh -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="12" Opacity="0.4" ShadowDepth="0" Direction="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Button Ghost (Hủy bỏ) tĩnh -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- TITLE (Tiêu đề) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <Border Width="45" Height="45" Background="#F39C12" CornerRadius="8" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect Color="#F39C12" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="⏳" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GIA HẠN PHÒNG" FontSize="22" FontWeight="Black" Foreground="#FFFFFF"/>
                <TextBlock Text="Thay đổi thời gian trả phòng dự kiến của khách hàng" FontSize="13" Foreground="#A0A5C1" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <!-- THÔNG TIN CHI TIẾT (Content Card) -->
        <Border Grid.Row="1" Background="#25283D" CornerRadius="16" Padding="35" Margin="0,0,0,25">
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="25" Opacity="0.5" ShadowDepth="8" Direction="270"/>
            </Border.Effect>

            <StackPanel>

                <!-- Hiển thị Mã phòng & Tên khách -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SỐ PHÒNG:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Room.RoomNumber}" Style="{StaticResource ValueStyle}" FontSize="20" Foreground="#3498DB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="KHÁCH HÀNG:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding CreatedByNavigation.FullName}" Style="{StaticResource ValueStyle}" FontSize="18"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#353A56" Margin="0,0,0,20"/>
                <!-- Ngày nhận phòng thực tế hoặc dự kiến -->
                <TextBlock Text="THỜI GIAN NHẬN PHÒNG:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding ExpectedCheckIn, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Style="{StaticResource ValueStyle}" Margin="0,0,0,20"/>
                <!-- Ngày trả phòng cũ -->
                <TextBlock Text="THỜI GIAN TRẢ PHÒNG HIỆN TẠI:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding ExpectedCheckOut, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Style="{StaticResource ValueStyle}" Foreground="#E74C3C" Margin="0,0,0,25"/>
                <!-- Ngày trả phòng mới cần chọn -->
                <TextBlock Text="THỜI GIAN TRẢ PHÒNG MỚI (*):" Style="{StaticResource LabelStyle}" Foreground="#FFFFFF"/>
                <Border Background="#1E2030" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="48" Margin="0,10,0,0">
                    <DatePicker x:Name="dpNewCheckOut" Foreground="Black" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        <!-- BUTTONS (Thanh điều hướng nút bấm) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- Nút Xác Nhận (Phải để x:Name và sự kiện đúng như mã cũ của bạn) -->
            <Button x:Name="btnSave" Content="XÁC NHẬN GIA HẠN" Width="180" Style="{StaticResource ModernButton}" Margin="0,0,15,0" Click="BtnSave_Click"/>

            <!-- Nút Hủy Bỏ -->
            <Button Content="HỦY BỎ" Width="120" Style="{StaticResource GhostButton}" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
