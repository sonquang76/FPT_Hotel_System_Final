<Window x:Class="WPF_FPT_ManagementHotel.AddRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Room"
        Height="900" Width="700"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <!-- Style TextBox (Bo góc tĩnh tĩnh) -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F334D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Nút Save (Primary tĩnh) -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="12" Opacity="0.4" ShadowDepth="0" Direction="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Nút Cancel (Ghost Button tĩnh) -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Vùng chứa Form (Card) -->
        <Border Background="#25283D" CornerRadius="16" Margin="30" Padding="35,40" VerticalAlignment="Center">
            <!-- Đổ bóng 3D -->
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="30" Opacity="0.5" ShadowDepth="8" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <!-- Tiêu Đề và Biểu tượng -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,35">
                    <Border Width="65" Height="65" Background="#2ECC71" CornerRadius="35" Margin="0,0,0,15" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#2ECC71" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="🛏️" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ADD NEW ROOM" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Số Phòng -->
                <TextBlock Text="ROOM NUMBER" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtRoomNumber" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                <!-- Loại Phòng -->
                <TextBlock Text="ROOM TYPE" Style="{StaticResource LabelStyle}"/>
                <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="48" Margin="0,0,0,20">
                    <ComboBox x:Name="cbRoomType" FontSize="15" Foreground="Black"
                              Background="Transparent" BorderThickness="0"
                              DisplayMemberPath="TypeName" SelectedValuePath="RoomTypeId"
                              VerticalContentAlignment="Center" Padding="15,0"/>
                </Border>
                <!-- Tầng -->
                <TextBlock Text="FLOOR" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtFloor" Style="{StaticResource ModernTextBox}" Margin="0,0,0,35"/>
                <!-- Hai nút Save và Cancel -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnSave" Content="SAVE" Grid.Column="0"
                            Style="{StaticResource ModernButton}" 
                            Click="btnSave_Click"/>
                    <Button x:Name="btnCancel" Content="CANCEL" Grid.Column="2"
                            Style="{StaticResource GhostButton}" 
                            Click="btnCancel_Click"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>