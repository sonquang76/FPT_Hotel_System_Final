<Window x:Class="WPF_FPT_ManagementHotel.AccountInformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="AccountInformationDialog" Height="900" Width="700"
        Background="#1E2030" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style cho Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <!-- Style cho TextBox (Bo góc, đổi viền xanh lá khi Focus) -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F334D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2ECC71"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8"
                                x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C638A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                                <Setter TargetName="border" Property="Background" Value="#353A56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style cho Nút Cập Nhật (Shadow Glow + Hiệu ứng lún khi click) -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                x:Name="border">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="15" Opacity="0.4" ShadowDepth="0" Direction="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E8449"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Vùng chứa Form (Card UI) -->
        <Border Background="#25283D" CornerRadius="16" Margin="40" Padding="40,50" MaxWidth="550" VerticalAlignment="Center">
            <!-- Bóng đổ nổi bật 3D -->
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="40" Opacity="0.6" ShadowDepth="10" Direction="270"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- Chia cột và hàng -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: Tiêu đề -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Full Name -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Gender & DOB -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Email -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Phone & Identity -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: Button Update -->
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <!-- Spacing -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Khu vực Avatar và Tiêu Đề -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <Border Width="70" Height="70" Background="#2ECC71" CornerRadius="35" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="20" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                            <!-- Icon giả lập Avatar (Dùng Text Emoji) -->
                            <TextBlock Text="👤" FontSize="35" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="ACCOUNT INFORMATION" 
                                   FontSize="24" FontWeight="Black" 
                                   Foreground="#FFFFFF" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="View and update your personal details" 
                                   FontSize="14" Foreground="#A0A5C1" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <!-- Hàng 1: Full Name (Chiếm toàn bộ chiều rộng) -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="FULL NAME" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtFullName" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <!-- Hàng 2: Gender (Trái) & Date of Birth (Phải) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="GENDER" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtGender" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="DATE OF BIRTH" Style="{StaticResource LabelStyle}"/>
                        <Border Background="#2F334D" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="48">
                            <DatePicker x:Name="dpDate" FontSize="15" Foreground="Black"
                                        Background="Transparent" BorderThickness="0"
                                        VerticalContentAlignment="Center" Padding="10,0"
                                        SelectedDate="{Binding Dob, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </StackPanel>
                    <!-- Hàng 3: Email (Chiếm toàn bộ chiều rộng) -->
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <!-- Hàng 4: Phone (Trái) & Identity Card (Phải) -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,35">
                        <TextBlock Text="PHONE NUMBER" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtPhone" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,35">
                        <TextBlock Text="IDENTITY CARD" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtCard" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding IdentityCard, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <!-- Hàng 5: Nút Update -->
                    <Button Grid.Row="5" Grid.ColumnSpan="3"
                            Content="UPDATE INFORMATION" 
                            Style="{StaticResource ModernButton}"
                            Click="BtnUpdate_Click"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>