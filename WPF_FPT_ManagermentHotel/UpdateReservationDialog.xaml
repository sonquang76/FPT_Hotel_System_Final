<Window x:Class="WPF_FPT_ManagementHotel.UpdateReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Reservation"
        Height="620"
        Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">

    <Window.Resources>
        <!-- Style Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style TextBox hiện đại (Dark Theme) -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F334D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ComboBox hiện đại (Dark Theme) -->
        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F334D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style Nút bấm chung -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <!-- Card Container -->
        <Border Background="#25283D" CornerRadius="16" Padding="35,30">
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="25" Opacity="0.5" ShadowDepth="8" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Tiêu đề -->
                    <RowDefinition Height="Auto"/>
                    <!-- Customer Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Phone -->
                    <RowDefinition Height="Auto"/>
                    <!-- Email -->
                    <RowDefinition Height="Auto"/>
                    <!-- Room -->
                    <RowDefinition Height="Auto"/>
                    <!-- Status -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <TextBlock Text="UPDATE RESERVATION"
                               FontSize="22"
                               FontWeight="Black"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Modify reservation and booking details" 
                               FontSize="13" 
                               Foreground="#A0A5C1" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Customer Name -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Customer Name"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,0,0,18"/>

                <TextBox x:Name="txtCustomerName"
                         Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,18"/>

                <!-- Phone -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Phone"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,0,0,18"/>

                <TextBox x:Name="txtPhone"
                         Grid.Row="2"
                         Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,18"/>

                <!-- Email -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Email"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,0,0,18"/>

                <TextBox x:Name="txtEmail"
                         Grid.Row="3"
                         Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,18"/>

                <!-- Room -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Room"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,0,0,18"/>

                <ComboBox x:Name="cbRoom"
                          Grid.Row="4"
                          Grid.Column="1"
                          Style="{StaticResource ModernComboBox}"
                          DisplayMemberPath="RoomNumber"
                          SelectedValuePath="RoomId"
                          Margin="0,0,0,18"/>

                <!-- Booking Status -->
                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Booking Status"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,0,0,25"/>

                <ComboBox x:Name="cbStatus"
                          Grid.Row="5"
                          Grid.Column="1"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,25">
                    <ComboBoxItem Content="Confirmed"/>
                    <ComboBoxItem Content="CheckedIn"/>
                    <ComboBoxItem Content="CheckedOut"/>
                    <ComboBoxItem Content="Cancelled"/>
                </ComboBox>

                <!-- Buttons -->
                <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnCancel"
                            Grid.Column="2"
                            Content="Cancel"
                            Style="{StaticResource ModernButton}"
                            Background="#E74C3C"
                            Click="BtnCancel_Click"/>

                    <Button x:Name="btnUpdate"
                            Grid.Column="0"
                            Content="Update"
                            Style="{StaticResource ModernButton}"
                            Background="#2ECC71"
                            Click="BtnUpdate_Click"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>