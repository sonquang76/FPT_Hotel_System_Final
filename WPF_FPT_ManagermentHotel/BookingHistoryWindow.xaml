<Window x:Class="WPF_FPT_ManagementHotel.BookingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booking History"
        Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Nút Primary (View Detail) -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="border">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="10" Opacity="0.3" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E8449"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Nút Cancel (Danger Ghost Style) -->
        <Style TargetType="Button" x:Key="DangerGhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#351F24"/>
                                <!-- Nền đỏ cực nhạt khi trỏ chuột -->
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E74C3C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- THANH TIÊU ĐỀ (TOP BAR) -->
        <Border Grid.Row="0" Background="#25283D" Padding="40,25">
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="25" Opacity="0.5" ShadowDepth="6" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="50" Height="50" Background="#2ECC71" CornerRadius="12" Margin="0,0,15,0">
                    <TextBlock Text="📜" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="MY BOOKING HISTORY" FontSize="26" FontWeight="Black" Foreground="#FFFFFF"/>
                    <TextBlock Text="Review all your past and upcoming reservations" FontSize="14" Foreground="#A0A5C1" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- DANH SÁCH THẺ (LIST CARDS) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,20">
            <!-- Giữ nguyên tên icBookings -->
            <ItemsControl x:Name="icBookings" Margin="10">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Giữ lại WrapPanel để các thẻ tự xuống dòng -->
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- KHUNG THẺ (CARD CONTAINER) -->
                        <Border Width="340" Margin="15" Background="#25283D" CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="#0A0B12" Opacity="0.4" ShadowDepth="8" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- HÌNH ẢNH (Bo góc viền trên) -->
                             
                                <!-- NỘI DUNG (CONTENT) -->
                                <StackPanel Margin="25,20">

                                    <!-- Tiêu đề & Loại Phòng -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Phòng " FontSize="22" FontWeight="Black" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Room.RoomNumber}" FontSize="22" FontWeight="Black" Foreground="#2ECC71" Margin="0,0,10,0"/>

                                        <Border Background="#353A56" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Room.RoomType.TypeName}" FontSize="12" FontWeight="Bold" Foreground="#A0A5C1"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- Huy Hiệu Trạng Thái (Status Badge) -->
                                    <Border Margin="0,5,0,15" Padding="12,6" CornerRadius="6" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#3498DB"/>
                                                <!-- Mặc định màu xanh dương -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BookingStatus}" Value="Reserved">
                                                        <Setter Property="Background" Value="#F39C12"/>
                                                        <!-- Màu cam -->
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BookingStatus}" Value="Confirmed">
                                                        <Setter Property="Background" Value="#2ECC71"/>
                                                        <!-- Màu xanh lá -->
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BookingStatus}" Value="CheckedIn">
                                                        <Setter Property="Background" Value="#9B59B6"/>
                                                        <!-- Màu tím -->
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BookingStatus}" Value="Cancelled">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                        <!-- Màu đỏ -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BookingStatus}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <!-- Khung Thời Gian (Timeline Box) -->
                                    <Border Background="#1E2030" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Check In -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CHECK-IN" FontSize="11" Foreground="#8E93B0" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ExpectedCheckIn,StringFormat=dd/MM/yyyy}" FontSize="14" Foreground="#FFFFFF" FontWeight="Bold"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="➞" Foreground="#444A73" VerticalAlignment="Center" Margin="15,0" FontSize="18"/>

                                            <!-- Check Out -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="CHECK-OUT" FontSize="11" Foreground="#8E93B0" FontWeight="SemiBold" Margin="0,0,0,4" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding ExpectedCheckOut,StringFormat=dd/MM/yyyy}" FontSize="14" Foreground="#FFFFFF" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Tiền Đặt Cọc (Deposit) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,25" HorizontalAlignment="Center">
                                        <TextBlock Text="Đã đặt cọc:" FontSize="14" Foreground="#A0A5C1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Payments[0].Amount,StringFormat={}{0:N0} VND}" FontSize="20" FontWeight="Black" Foreground="#F39C12" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <!-- CÁC NÚT TƯƠNG TÁC (Giữ nguyên Click="...") -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <!-- Khoảng cách giữa 2 nút -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="42" Content="VIEW DETAIL" 
                                                Style="{StaticResource ModernButton}" 
                                                Click="btnDetail_Click"/>

                                        <Button Grid.Column="2" Height="42" Content="CANCEL" 
                                                Style="{StaticResource DangerGhostButton}" 
                                                Click="btnCancel_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>