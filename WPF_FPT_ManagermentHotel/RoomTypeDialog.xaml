<Window x:Class="WPF_FPT_ManagementHotel.RoomTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="RoomTypeDialog" Height="760" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">

    <Window.Resources>
        <!-- Style Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Style TextBox Tĩnh -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#25283D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Tĩnh -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Button Ghost (Dùng cho nút Browse) -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="*"/>
            <!-- Form nhập liệu -->
            <RowDefinition Height="Auto"/>
            <!-- Các nút bấm -->
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25" HorizontalAlignment="Center">
            <TextBlock x:Name="txtDialogTitle" Text="📝 ADD ROOM TYPE" FontSize="22" FontWeight="Black" Foreground="#FFFFFF"/>
        </StackPanel>

        <!-- Form nhập liệu -->
        <StackPanel Grid.Row="1">
            <!-- Type Name -->
            <TextBlock Text="TYPE NAME" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="txtTypeName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20" MaxLength="50"/>

            <!-- Base Price -->
            <TextBlock Text="BASE PRICE (VND)" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="txtBasePrice" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

            <!-- Capacity -->
            <TextBlock Text="CAPACITY (PERSONS)" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="txtCapacity" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

            <!-- Đường dẫn ảnh (Image URL) -->
            <TextBlock Text="IMAGE (URL / PATH)" Style="{StaticResource LabelStyle}"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Textbox chứa đường dẫn ảnh -->
                <TextBox x:Name="txtUrl" Grid.Column="0" 
                         Style="{StaticResource ModernTextBox}" 
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Nút Mở hộp thoại chọn file -->
                <Button x:Name="btnBrowse" Grid.Column="2" 
                        Content="BROWSE" 
                        Style="{StaticResource GhostButton}" 
                        Click="btnBrowse_Click"/>
            </Grid>

            <!-- Khung xem trước ảnh (Image Preview) -->
            <Border Background="#1E2030" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="200" Margin="0,0,0,20">
                <Image x:Name="imgPreview" Stretch="Uniform" Margin="5" Source="{Binding Url}"/>
            </Border>

        </StackPanel>


        <!-- Nút bấm -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancel" Grid.Column="0" Content="Cancel" 
                    Style="{StaticResource ModernButton}" Background="#E74C3C" 
                    Click="btnCancel_Click"/>

            <Button x:Name="btnSave" Grid.Column="2" Content="Save" 
                    Style="{StaticResource ModernButton}" Background="#2ECC71" 
                    Click="btnSave_Click"/>

        </Grid>

    </Grid>
</Window>