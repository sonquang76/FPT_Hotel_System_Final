<Window x:Class="WPF_FPT_ManagementHotel.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="Admin Dashboard" Height="750" Width="1240"
        Background="#1E2030" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Nút Đăng xuất / Xóa (Đỏ) Tĩnh -->
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style TabItem Tĩnh (Chỉ thay đổi khi được click chọn, KHÔNG hover) -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E2030"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="Padding" Value="25,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- Trùng màu với DataGrid bên dưới để tạo khối liền mạch -->
                                <Setter TargetName="Border" Property="Background" Value="#25283D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGrid Styles Tĩnh (Dark Theme) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#25283D"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#25283D"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2D45"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#353A56"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="50"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E2030"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,15"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút nhỏ trong DataGrid -->
        <Style TargetType="Button" x:Key="GridActionButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- ================= SIDEBAR TRÁI ================= -->
        <Border Grid.Column="0" Background="#25283D">
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="20" Opacity="0.4" ShadowDepth="5" Direction="0"/>
            </Border.Effect>
            <Grid>
                <StackPanel Margin="0,40,0,0">
                    <Border Width="64" Height="64" Background="#3498DB" CornerRadius="32" Margin="0,0,0,20">
                        <TextBlock Text="🛡️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="FPT ADMIN" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="SYSTEM PANEL" FontSize="13" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,4,0,40"/>
                </StackPanel>
                <Button x:Name="btnLogout" Content="🚪 LOGOUT" Style="{StaticResource DangerButton}" Margin="30,0,30,40" VerticalAlignment="Bottom" Click="BtnLogout_Click"/>
            </Grid>
        </Border>
        <!-- ================= NỘI DUNG CHÍNH ================= -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Header (Welcome & Stats) -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtWelcome" Text="HELLO, ADMIN" FontSize="28" FontWeight="Black" Foreground="#FFFFFF"/>
                    <TextBlock Text="Welcome to Hotel Management System Dashboard" FontSize="15" Foreground="#A0A5C1" Margin="0,5,0,0"/>
                </StackPanel>
                <!-- Stats Cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="170" Height="85" Background="#3498DB" CornerRadius="12" Margin="0,0,15,0" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect Color="#3498DB" BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="MANAGERS" FontSize="13" FontWeight="Bold" Foreground="#E0E6ED" VerticalAlignment="Top"/>
                            <TextBlock x:Name="txtManagerCount" Text="0" FontSize="34" FontWeight="Black" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-5"/>
                        </Grid>
                    </Border>

                    <Border Width="170" Height="85" Background="#2ECC71" CornerRadius="12" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect Color="#2ECC71" BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="USERS / CUSTOMERS" FontSize="13" FontWeight="Bold" Foreground="#E0E6ED" VerticalAlignment="Top"/>
                            <TextBlock x:Name="txtUserCount" Text="0" FontSize="34" FontWeight="Black" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-5"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            <!-- Quản lý (TabControl) -->
            <TabControl x:Name="tcAdminManagement" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- 1. QUẢN LÝ MANAGERS -->
                <TabItem Header="MANAGE MANAGERS">
                    <Border Background="#25283D" CornerRadius="0,12,12,12" Padding="20">
                        <DataGrid x:Name="dgManagers" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="90"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding AccountStatus}" Width="120"/>
                                <DataGridTemplateColumn Header="Action" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="TOGGLE STATUS" Style="{StaticResource GridActionButton}" Background="#F39C12" Click="BtnToggleStatus_Click"/>
                                                <Button Content="DELETE" Style="{StaticResource GridActionButton}" Background="#E74C3C" Click="BtnDeleteManager_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
                <!-- 2. QUẢN LÝ USERS -->
                <TabItem Header="MANAGE USERS">
                    <Border Background="#25283D" CornerRadius="0,12,12,12" Padding="20">
                        <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="90"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding AccountStatus}" Width="120"/>
                                <DataGridTemplateColumn Header="Action" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="TOGGLE STATUS" Style="{StaticResource GridActionButton}" Background="#F39C12" Click="BtnToggleStatus_Click"/>
                                                <Button Content="DELETE" Style="{StaticResource GridActionButton}" Background="#E74C3C" Click="BtnDeleteUser_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>