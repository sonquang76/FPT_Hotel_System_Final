<Window x:Class="WPF_FPT_ManagementHotel.RoomAfterBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booking Detail"
         Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Style Giá trị (Value) -->
        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Style TextBox tĩnh (Chỉ đọc) -->
        <Style TargetType="TextBox" x:Key="ReadOnlyTextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="Background" Value="#1E2030"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Nút Danger (Hủy đặt phòng) tĩnh -->
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#E74C3C" BlurRadius="12" Opacity="0.4" ShadowDepth="0" Direction="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Nút Ghost (Đóng) tĩnh -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- TITLE -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <Border Width="45" Height="45" Background="#3498DB" CornerRadius="8" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect Color="#3498DB" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="📄" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="BOOKING DETAIL" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        </StackPanel>
        <!-- MAIN CONTENT CARD -->
        <Border Grid.Row="1" Background="#25283D" CornerRadius="16" Padding="35">
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="30" Opacity="0.5" ShadowDepth="8" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="40"/>
                    <!-- Spacing -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- ROOM IMAGE -->
                <!-- Thêm Source placeholder để nhìn không bị trống -->
                <Border Grid.Column="0" CornerRadius="12" Background="#1E2030">
                    <Border CornerRadius="12" ClipToBounds="True">
                        <Image Stretch="UniformToFill" Source="/Images/room.png"/>
                    </Border>
                </Border>
                <!-- INFORMATION FORM -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ROOM NUMBER:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtRoomNumber" Style="{StaticResource ValueStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ROOM TYPE:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtRoomType" Style="{StaticResource ValueStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="FLOOR:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtFloor" Style="{StaticResource ValueStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CHECK IN:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtCheckIn" Style="{StaticResource ValueStyle}"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="CHECK OUT:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtCheckOut" Style="{StaticResource ValueStyle}"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="NIGHTS:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtNight" Style="{StaticResource ValueStyle}"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="DEPOSIT PAID:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtDeposit" Style="{StaticResource ValueStyle}" Foreground="#3498DB"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="STATUS:" Style="{StaticResource LabelStyle}"/>
                    <Border Grid.Row="7" Grid.Column="1" x:Name="bdStatus" Width="120" Height="30" CornerRadius="6" Background="#2ECC71" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="txtStatus" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="13"/>
                    </Border>
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="DESCRIPTION:" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Margin="0,15,0,0"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtDescription" Style="{StaticResource ReadOnlyTextBox}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="15" Margin="0,15,0,0"/>
                </Grid>
            </Grid>
        </Border>
        <!-- BUTTONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
            <Button x:Name="btnCancelBooking" Width="200" Content="CANCEL BOOKING" Style="{StaticResource DangerButton}" Margin="0,0,20,0" Click="btnCancelBooking_Click"/>
            <Button Width="130" Content="CLOSE" Style="{StaticResource GhostButton}" Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>