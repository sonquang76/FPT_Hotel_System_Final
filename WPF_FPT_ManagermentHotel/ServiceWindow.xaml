<Window x:Class="WPF_FPT_ManagementHotel.ServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="Service &amp; Billing Management" Height="650" Width="1200" 
        WindowStartupLocation="CenterScreen" Background="#1E2030">

    <Window.Resources>
        <!-- Style cho các nút điều hướng Sidebar bên trái -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F334D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#444A73"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho các nút hành động trong bảng DataGrid -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--================ LEFT SIDEBAR ================-->
        <Border Grid.Column="0" Background="#25283D" CornerRadius="0" BorderBrush="#444A73" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,30,20,30" HorizontalAlignment="Center">
                    <TextBlock Text="FPT HOTEL" FontSize="24" FontWeight="Black" Foreground="White" />
                    <TextBlock Text="Management System" FontSize="11" Foreground="#A0A5C1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
        
                    <Button Content="Reservations" Style="{StaticResource MenuButtonStyle}" Click="BtnReservations_Click"/>
                    <Button Content="Room Management" Style="{StaticResource MenuButtonStyle}" Click="BtnRoomManagement_Click"/>
                    <Button Content="Services &amp; Bills" Style="{StaticResource MenuButtonStyle}" Tag="Active"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--================ RIGHT CONTENT AREA ================-->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER SECTION -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Thanh Gold Accent bên trái tiêu đề -->
                    <Border Width="4" Height="36" Background="#F1C40F" CornerRadius="2" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="SERVICES &amp; BILLS REPORT" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="View detailed breakdown of booked room services and revenues" FontSize="11" Foreground="#A0A5C1" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- btnRefresh -->
                <Button x:Name="btnRefresh" Grid.Column="1" Click="BtnRefresh_Click" Content="Refresh Report" Padding="15,0" Width="90" Height="38" Background="#2F334D" Foreground="#FFFFFF" BorderBrush="#444A73" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#444A73"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- btnLogout -->
                <Button x:Name="btnLogout" Grid.Column="2" Click="BtnLogout_Click" Content="Logout" Padding="18,0" Width="70" Height="38" Background="#E74C3C" Foreground="White" FontWeight="SemiBold" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 2. SEARCH & FILTER SECTION -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2F334D" BorderBrush="#444A73" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6" Height="38">
                        <TextBox x:Name="txtSearch" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" TextChanged="TxtSearch_TextChanged"/>
                    </Border>
                    <Button x:Name="btnSearch" Grid.Column="1" Click="BtnSearch_Click" Width="50" Height="38" Background="#3498DB" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 14,14 L 20,20 M 16,10 A 6,6 0 1,1 4,10 A 6,6 0 1,1 16,10 Z" Stroke="White" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <CheckBox x:Name="chkFilterByDate" Content="Filter by date:" FontWeight="Medium" Foreground="#A0A5C1" VerticalAlignment="Center" Checked="ChkFilterByDate_Changed" Unchecked="ChkFilterByDate_Changed"/>
                    <DatePicker x:Name="dpFilterDate" Margin="10,0,0,0" Width="150" Height="30" VerticalAlignment="Center" SelectedDateChanged="DpFilterDate_SelectedDateChanged"/>
                </StackPanel>
            </Grid>

            <!-- 3. TABLE SECTION -->
            <Border Grid.Row="2" Background="#25283D" CornerRadius="10" Padding="15" BorderBrush="#444A73" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Detailed Service Usage History" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="5,0,0,12"/>

                    <DataGrid x:Name="dgServiceHistory" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="Transparent" 
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal" 
                              RowBackground="#2F334D" 
                              AlternatingRowBackground="#25283D" 
                              Foreground="#FFFFFF" 
                              BorderBrush="#444A73"
                              HorizontalGridLinesBrush="#1E2030"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#444A73"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Tối ưu hóa kích thước các cột -->
                            <DataGridTextColumn Header="Room No." Binding="{Binding Booking.Room.RoomNumber}" Width="80" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Booking.CreatedByNavigation.FullName}" Width="130"/>

                            <!-- BỔ SUNG MINWIDTH ĐỂ TÊN DỊCH VỤ KHÔNG BỊ CO LẠI -->
                            <DataGridTextColumn Header="Service Name" Binding="{Binding Service.ServiceName}" Width="*" MinWidth="160"/>

                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="Total Price" Binding="{Binding Price, StringFormat=\{0:N0\} VND}" Width="120" Foreground="#F39C12" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Order Time" Binding="{Binding OrderTime, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="125"/>

                            <!-- Cột Trạng thái Status -->
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OrderStatus}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="Pending">
                                                            <Setter Property="Foreground" Value="#F39C12"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="Confirmed">
                                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="Completed">
                                                            <Setter Property="Foreground" Value="#3498DB"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="Cancelled">
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột hành động Actions (Thu gọn 160px để hiển thị đẹp hơn) -->
                            <DataGridTemplateColumn Header="Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                            <!-- Confirm Button -->
                                            <Button Content="Confirm" Background="#2ECC71" CommandParameter="{Binding ServiceOrderId}" Click="BtnConfirm_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#27AE60"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Cancel Button -->
                                            <Button Content="Cancel" Background="#E74C3C" CommandParameter="{Binding ServiceOrderId}" Click="BtnCancel_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#C0392B"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Complete Button -->
                                            <Button Content="Complete" Background="#3498DB" CommandParameter="{Binding ServiceOrderId}" Click="BtnComplete_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Confirmed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2980B9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>