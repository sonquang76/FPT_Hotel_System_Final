<Window x:Class="WPF_FPT_ManagementHotel.RoomDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Detail"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="130"/>
            <!-- Giữ cố định chiều rộng cho thẳng hàng -->
        </Style>
        <!-- Style Giá Trị (Value) -->
        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Style TextBox tĩnh (Chỉ Đọc - Cho mô tả) -->
        <Style TargetType="TextBox" x:Key="ReadOnlyTextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="Background" Value="#1E2030"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Nút Book Now (Primary Tĩnh) -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="12" Opacity="0.4" ShadowDepth="0" Direction="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Nút Close (Ghost Tĩnh) -->
        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- TITLE (HEADER) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <Border Width="45" Height="45" Background="#3498DB" CornerRadius="8" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect Color="#3498DB" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="ℹ️" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="ROOM DETAIL" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        </StackPanel>
        <!-- MAIN CARD -->
        <Border Grid.Row="1" Background="#25283D" CornerRadius="16" Padding="35">
            <!-- Đổ bóng 3D Card -->
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="30" Opacity="0.5" ShadowDepth="8" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="40"/>
                    <!-- Khoảng cách (Spacing) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- IMAGE (Bên Trái) -->
                
                <!-- Thêm Source mặc định, nếu trong code bạn gán Source khác thì nó sẽ tự đè lên -->
                <Border Grid.Column="0" CornerRadius="12" Background="#1E2030">
                    <Border CornerRadius="12" ClipToBounds="True">
                        <Image x:Name="imgRoom" Stretch="UniformToFill" Source="{Binding RoomType.URL, TargetNullValue='/Image/RoomTypeStandard.jpg', FallbackValue='/Image/RoomTypeStandard.jpg'}"/>
                    </Border>
                </Border>
                <!-- RIGHT INFO (Bên Phải) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Room Number -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="ROOM NUMBER:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="txtRoomNumber" Style="{StaticResource ValueStyle}" FontSize="20"/>
                    </StackPanel>
                    <!-- Room Type -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="ROOM TYPE:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="txtRoomType" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <!-- Floor -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="FLOOR:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="txtFloor" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <!-- Price -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="PRICE / NIGHT:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="txtPrice" Style="{StaticResource ValueStyle}" Foreground="#2ECC71" FontSize="20"/>
                    </StackPanel>
                    <!-- Status -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Text="STATUS:" Style="{StaticResource LabelStyle}"/>
                        <!-- Giữ x:Name="bdStatus" cho code phía sau đổi màu, đặt mặc định Blue -->
                        <Border x:Name="bdStatus" Height="34" CornerRadius="6" Background="#3498DB" Padding="15,0">
                            <TextBlock x:Name="txtStatus" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <!-- DESCRIPTION -->
                    <StackPanel Grid.Row="5" Margin="0,0,0,20">
                        <TextBlock Text="DESCRIPTION:" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
                        <TextBox x:Name="txtDescription" Style="{StaticResource ReadOnlyTextBox}" 
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                 AcceptsReturn="True" VerticalContentAlignment="Top" Padding="15"/>
                    </StackPanel>
                    <!-- BUTTONS -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="btnBook" Content="BOOK NOW" Style="{StaticResource ModernButton}" Width="160" Margin="0,0,15,0" Click="btnBook_Click"/>
                        <Button Content="CLOSE" Style="{StaticResource GhostButton}" Width="120" Click="btnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>