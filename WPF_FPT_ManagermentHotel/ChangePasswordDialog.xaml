<Window x:Class="WPF_FPT_ManagementHotel.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FPT_ManagementHotel"
        mc:Ignorable="d"
        Title="ChangePasswordDialog" Height="900" Width="700"
        Background="#1E2030" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style cho Nhãn (Label) -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <!-- Style cho PasswordBox (Bo góc, đổi viền xanh khi focus) -->
        <Style TargetType="PasswordBox" x:Key="ModernPasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F334D"/>
            <Setter Property="BorderBrush" Value="#444A73"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2ECC71"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8"
                                x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C638A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                                <Setter TargetName="border" Property="Background" Value="#353A56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style cho Nút Bấm -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                x:Name="border">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ECC71" BlurRadius="15" Opacity="0.4" ShadowDepth="0" Direction="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E8449"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Vùng chứa Form (Card UI) -->
        <Border Background="#25283D" CornerRadius="16" Margin="30" Padding="40" MaxWidth="450" VerticalAlignment="Center">
            <!-- Đổ bóng 3D -->
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="40" Opacity="0.6" ShadowDepth="10" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <!-- Tiêu Đề và Biểu tượng Ổ khóa -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,35">
                    <Border Width="65" Height="65" Background="#2ECC71" CornerRadius="35" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#2ECC71" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="🔒" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CHANGE PASSWORD" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please enter your new password below" FontSize="13" Foreground="#A0A5C1" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <!-- Mật khẩu hiện tại -->
                <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="txtOldPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,20"/>
                <!-- Mật khẩu mới -->
                <TextBlock Text="NEW PASSWORD" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="txtNewPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,20"/>
                <!-- Xác nhận mật khẩu mới -->
                <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="txtConfirmPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,35"/>
                <!-- Nút Cập nhật -->
                <Button Content="UPDATE PASSWORD" 
                        Style="{StaticResource ModernButton}" 
                        Click="BtnChange_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>