<Window x:Class="WPF_FPT_ManagementHotel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Booking &amp; Reservation Management"
        Height="850" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#1E2030"
        FontFamily="Segoe UI, Helvetica, Arial, sans-serif">
    <Window.Resources>
        <!-- Style cho Trạng thái RadioButton (Thiết kế dạng Pill Toggle) -->
        <Style TargetType="RadioButton" x:Key="StatusRadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A5C1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2ECC71"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <!-- Header Menu -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filter Bar -->
            <RowDefinition Height="*"/>
            <!-- Danh sách phòng -->
        </Grid.RowDefinitions>
        <!-- 1. HEADER / MENU BARS -->
        <Grid Grid.Row="0" Background="#25283D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- App Logo / Branding -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="30,0">
                <TextBlock Text="FPT" FontWeight="Black" FontSize="22" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="HOTEL" FontWeight="Bold" FontSize="22" Foreground="#2ECC71" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <!-- Menu Trái -->
            <Menu Grid.Column="1" Background="Transparent" Margin="30,0,0,0" VerticalAlignment="Center">
                <MenuItem Header="Privacy Menu" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" Padding="15,10">
                    <MenuItem Header="Information" Name="btnInforAccount" Click="btnInforAccount_Click" Foreground="Black"/>
                    <MenuItem Header="Change Password" Name="btnChagePassword" Click="btnChagePassword_Click" Foreground="Black"/>
                    <MenuItem Header="History Booking" Name="btnHistoryBooking" Click="btnHistoryBooking_Click" Foreground="Black"/>
                </MenuItem>
            </Menu>
            <!-- Menu Phải (Logout) -->
            <Menu Grid.Column="2" Background="Transparent" Margin="0,0,25,0" VerticalAlignment="Center">
                <MenuItem Header="Logout" Name="btnLogout" Click="btnLogout_Click" Padding="15,10" FontWeight="Bold" Foreground="#E74C3C" FontSize="15"/>
            </Menu>
        </Grid>
        <!-- 2. TÌM KIẾM & LỌC (SEARCH & FILTER BAR) -->
        <Border Grid.Row="1" Background="#25283D" CornerRadius="12" Margin="25,20,25,10" Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#0A0B12" BlurRadius="20" Opacity="0.4" ShadowDepth="6" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <!-- Khung Date Filters -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 Check-in:" VerticalAlignment="Center" FontSize="14" Foreground="#A0A5C1" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <Border Background="#1E2030" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="48" Padding="10,0">
                            <DatePicker x:Name="dpCheckIn" Width="140" Foreground="Black" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                        <TextBlock Text="📅 Check-out:" VerticalAlignment="Center" FontSize="14" Foreground="#A0A5C1" Margin="25,0,10,0" FontWeight="SemiBold"/>
                        <Border Background="#1E2030" BorderBrush="#444A73" BorderThickness="1.5" CornerRadius="8" Height="48" Padding="10,0">
                            <DatePicker x:Name="dpCheckOut" Width="140" Foreground="Black" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Border>
                        <!-- Nút Lọc Phòng -->
                        <Button x:Name="btnFilterDate" Content="Filter Room" Click="btnFilterDate_Click"
                                Margin="25,0,0,0" Width="110" Height="48" 
                                Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#2ECC71" CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#2ECC71" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Dải phân cách -->
                <Border Grid.Row="1" BorderBrush="#353A56" BorderThickness="0,1,0,0" Margin="0,20"/>
                <!-- Khung Chọn Status -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Room Status:" VerticalAlignment="Center" FontSize="14" Foreground="#A0A5C1" Margin="0,0,20,0" FontWeight="SemiBold"/>
                    <RadioButton x:Name="rdAll" Content="All" GroupName="Status" Checked="rdStatus_Checked" Style="{StaticResource StatusRadioButton}"/>
                    <RadioButton x:Name="rdAvailable" Content="Available" GroupName="Status" Checked="rdStatus_Checked" Style="{StaticResource StatusRadioButton}"/>
                    <RadioButton x:Name="rdBooked" Content="Occupied" GroupName="Status" Checked="rdStatus_Checked" Style="{StaticResource StatusRadioButton}"/>
                    <RadioButton x:Name="rdMaintenance" Content="Maintenance" GroupName="Status" Checked="rdStatus_Checked" Style="{StaticResource StatusRadioButton}"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 3. DANH SÁCH PHÒNG (ROOM ITEMS) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="25,5,25,20" Padding="0,0,10,0">
            <ItemsControl x:Name="icRooms">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Thẻ Room (Card) - Tự động co giãn Height để vừa chữ -->
                        <Border Margin="0,0,0,20" Background="#25283D" CornerRadius="16" MinHeight="220">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#0A0B12" Opacity="0.4" ShadowDepth="5" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Hình ảnh và Trạng thái -->
                                <Grid Grid.Column="0">
                                    <Border CornerRadius="16,0,0,16" ClipToBounds="True">
                                        <Image Source="{Binding Room.RoomType.Url}" Stretch="UniformToFill"/>
                                    </Border>
                                    <!-- Badge Trạng Thái Bo Góc Ở Trên -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" Padding="12,6" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2ECC71"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BookingStatus}" Value="Reserved">
                                                        <Setter Property="Background" Value="#F39C12"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BookingStatus}" Value="Confirmed">
                                                        <Setter Property="Background" Value="#3498DB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BookingStatus}" Value="CheckedIn">
                                                        <Setter Property="Background" Value="#9B59B6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Room.Status}" Value="Maintenance">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="AVAILABLE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BookingStatus}" Value="Reserved">
                                                            <Setter Property="Text" Value="RESERVED"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BookingStatus}" Value="Confirmed">
                                                            <Setter Property="Text" Value="CONFIRMED"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BookingStatus}" Value="CheckedIn">
                                                            <Setter Property="Text" Value="CHECKED IN"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Room.Status}" Value="Maintenance">
                                                            <Setter Property="Text" Value="MAINTENANCE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <!-- Thông tin chi tiết phòng (Cột phải) -->
                                <Grid Grid.Column="1" Margin="30,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Tiêu đề -->
                                        <RowDefinition Height="*"/>
                                        <!-- Nội dung mô tả (Co giãn) -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Nút & Giá -->
                                    </Grid.RowDefinitions>
                                    <!-- Dòng 1: Tiêu Đề Phòng -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Phòng " FontSize="22" FontWeight="Black" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Room.RoomNumber}" FontSize="22" FontWeight="Black" Foreground="#2ECC71" Margin="0,0,12,0"/>
                                        <TextBlock Text="•" FontSize="22" Foreground="#444A73" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Room.RoomType.TypeName}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Dòng 2: Khu vực thông tin đan xen bằng StackPanel (Tránh đè chữ) -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">

                                        <!-- Khung thông tin khách hàng (Chỉ hiển thị khi có Booking) -->
                                        <StackPanel Margin="0,0,0,15">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BookingId}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BookingStatus}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Border Background="#1E2030" CornerRadius="8" Padding="15,10">
                                                <TextBlock FontSize="13" Foreground="#FFFFFF" FontWeight="Medium" TextWrapping="Wrap">
                                                    <Run Text="👤 Khách hàng: " Foreground="#A0A5C1"/>
                                                    <Run Text="{Binding Customer.FullName, FallbackValue='N/A'}" FontWeight="Bold"/>
                                                    <Run Text="   📅 Lịch trình: " Foreground="#A0A5C1"/>
                                                    <Run Text="{Binding ExpectedCheckIn, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#2ECC71"/>
                                                    <Run Text=" ➝ " Foreground="#A0A5C1"/>
                                                    <Run Text="{Binding ExpectedCheckOut, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#E74C3C" FontWeight="Bold"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <!-- Mô tả của Loại Phòng (RoomType.Description) -->
                                        <TextBlock Text="{Binding Room.RoomType.Description}" 
                                                   TextWrapping="Wrap" FontSize="14" Foreground="#A0A5C1" Margin="0,0,0,10" FontWeight="SemiBold" />
                                        <!-- Mô tả của cụ thể của Phòng (Room.Description) -->
                                        <TextBlock Text="{Binding Room.Description, TargetNullValue='Không có mô tả chi tiết', FallbackValue='Không có mô tả chi tiết'}" 
                                                   FontSize="13" Foreground="#8E93B0" TextWrapping="Wrap" Margin="0,0,20,0"/>

                                        
                                    </StackPanel>
                                    <!-- Dòng 3: Giá tiền & Nút Hành Động -->
                                    <Grid Grid.Row="2" Margin="0,15,0,0">
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Room.RoomType.BasePrice, StringFormat={}{0:N0} VND}" FontSize="24" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="✔ Taxes and fees are included." FontSize="12" Foreground="#2ECC71" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Nút Tương Tác Chính -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button x:Name="btnMainAction" Click="Room_Click" Width="140" Height="42" FontWeight="Bold" FontSize="13" BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#2ECC71"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Content" Value="BOOKING ROOM"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BookingStatus}" Value="Reserved">
                                                                <Setter Property="Background" Value="#F39C12"/>
                                                                <Setter Property="Content" Value="CHECK IN"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BookingStatus}" Value="Confirmed">
                                                                <Setter Property="Background" Value="#3498DB"/>
                                                                <Setter Property="Content" Value="OCCUPIED"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BookingStatus}" Value="CheckedIn">
                                                                <Setter Property="Background" Value="#9B59B6"/>
                                                                <Setter Property="Content" Value="TRẢ PHÒNG"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Room.Status}" Value="Maintenance">
                                                                <Setter Property="Background" Value="#2F334D"/>
                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                                <Setter Property="Content" Value="BẢO TRÌ"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Cursor" Value="No"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>